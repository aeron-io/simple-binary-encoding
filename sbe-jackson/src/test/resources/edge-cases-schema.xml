<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="edge"
                   id="9"
                   version="1"
                   semanticVersion="1.0"
                   description="Edge cases for sbe-jackson: uint64 enums and sets, optional floats, non UTF-8 text, huge groups"
                   byteOrder="littleEndian">
    <types>
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <composite name="groupSizeEncoding" description="Repeating group dimensions">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <composite name="varUtf16Encoding" description="UTF-16 text">
            <type name="length" primitiveType="uint16"/>
            <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-16"/>
        </composite>
        <composite name="varBinaryEncoding" description="Opaque bytes">
            <type name="length" primitiveType="uint16"/>
            <type name="varData" primitiveType="uint8" length="0"/>
        </composite>
        <type name="u64" primitiveType="uint64"/>
        <enum name="BigEnum" encodingType="u64">
            <validValue name="ONE">1</validValue>
            <validValue name="HIGH">9223372036854775808</validValue>
            <validValue name="TOP">18446744073709551614</validValue>
        </enum>
        <set name="BigSet" encodingType="uint64">
            <choice name="low">0</choice>
            <choice name="high">63</choice>
        </set>
        <type name="Utf16Name" primitiveType="char" length="8" characterEncoding="UTF-16BE"/>
        <type name="Pad" primitiveType="char" length="65000"/>
    </types>
    <sbe:message name="Edge" id="1" description="uint64 enum/set, optional float/double, UTF-16 text">
        <field name="bigEnum" id="1" type="BigEnum"/>
        <field name="bigSet" id="2" type="BigSet"/>
        <field name="optFloat" id="3" type="float" presence="optional"/>
        <field name="optDouble" id="4" type="double" presence="optional"/>
        <field name="optU64" id="5" type="uint64" presence="optional"/>
        <field name="name16" id="6" type="Utf16Name"/>
        <field name="bigConst" id="7" type="uint64" presence="constant">18446744073709551614</field>
        <field name="constEnum" id="8" type="BigEnum" presence="constant" valueRef="BigEnum.TOP"/>
        <group name="items" id="9" dimensionType="groupSizeEncoding">
            <field name="v" id="10" type="uint8"/>
        </group>
        <data name="text16" id="11" type="varUtf16Encoding"/>
        <data name="blob" id="12" type="varBinaryEncoding"/>
    </sbe:message>
    <sbe:message name="Wide" id="2" description="Group whose entries can push a message past the int range">
        <group name="rows" id="1" dimensionType="groupSizeEncoding">
            <field name="pad" id="2" type="Pad"/>
        </group>
    </sbe:message>
</sbe:messageSchema>
